{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": false,
        "noImplicitAny": false
    },
    "include": ["packages/dappfence/src/**/*.js", "packages/dappfence/types.d.ts"],
    "exclude": ["**/node_modules", "**/dist", "**/__tests__"]
}
