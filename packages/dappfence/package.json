{
    "name": "@dappfence/core",
    "version": "0.1.2",
    "description": "Security framework for web applications using service worker content verification",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coinspect/dappfence.git",
        "directory": "packages/dappfence"
    },
    "keywords": [
        "security",
        "service-worker",
        "integrity",
        "dapp",
        "web-security",
        "content-verification"
    ],
    "type": "module",
    "main": "dist/dappfence.js",
    "exports": {
        ".": {
            "development": "./dist/dappfence.dev.js",
            "default": "./dist/dappfence.js"
        },
        "./dev": "./dist/dappfence.dev.js",
        "./constants": "./src/core/constants.js"
    },
    "files": [
        "dist",
        "src/core/constants.js"
    ],
    "engines": {
        "node": ">=16.0.0"
    },
    "scripts": {
        "build": "vite build --mode development && vite build --mode production",
        "build:prod": "vite build --mode production",
        "build:watch": "vite build --mode development --watch & vite build --mode production --watch",
        "clean": "rm -rf dist coverage",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "publish:local": "npm run build:prod && npm pack --pack-destination ../../dist"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@noble/hashes": "2.0.1",
        "@noble/secp256k1": "3.0.0",
        "terser": "5.24.0",
        "vite": "8.0.16",
        "vite-plugin-bundle-obfuscator": "1.12.0"
    }
}
