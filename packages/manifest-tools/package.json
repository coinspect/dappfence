{
    "name": "@dappfence/manifest-tools",
    "version": "0.1.2",
    "description": "Signed integrity manifest builder for web applications",
    "license": "MIT",
    "type": "commonjs",
    "main": "src/build.js",
    "exports": {
        ".": "./src/build.js",
        "./crypto": "./src/crypto.js"
    },
    "files": [
        "src"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coinspect/dappfence.git",
        "directory": "packages/manifest-tools"
    },
    "keywords": [
        "security",
        "integrity",
        "manifest",
        "sha256",
        "signing"
    ],
    "scripts": {
        "publish:local": "npm pack --pack-destination ../../dist"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@noble/hashes": "2.0.1",
        "@noble/secp256k1": "3.0.0"
    }
}
