{
    "tagRulesets": [
        {
            "describedAs": "creation — maintainers only, so the release ceremony can push a tag",
            "pattern": "refs/tags/release-*",
            "rules": ["creation"],
            "bypassActors": "allowed"
        },
        {
            "describedAs": "protection — immutable for everyone, maintainers included",
            "pattern": "refs/tags/release-*",
            "rules": ["update", "deletion", "non_fast_forward"],
            "bypassActors": "forbidden"
        }
    ],
    "environment": {
        "name": "production-publish",
        "requireReviewers": true,
        "preventSelfReview": true,
        "deploymentBranches": ["main"]
    },
    "codeowners": {
        "requireNoErrors": true
    }
}
